<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        app:title="Workout Timer" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/timeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:00"
                android:textSize="72sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp" />

            <!-- Custom time: set any duration you like -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/minInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Min"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />
                <EditText
                    android:id="@+id/secInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Sec"
                    android:inputType="number"
                    android:layout_marginEnd="8dp" />
                <Button
                    android:id="@+id/setBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick set"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/p30" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30s" />
                <Button android:id="@+id/p60" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="60s" />
                <Button android:id="@+id/p90" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="90s" />
                <Button android:id="@+id/p120" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2m" />
                <Button android:id="@+id/p300" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5m" />
            </LinearLayout>

            <Button
                android:id="@+id/startBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Start" />

            <Button
                android:id="@+id/resetBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reset" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
